{
  "name": "chokepoint",
  "version": "0.11.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "A dynamic, agent-based simulator of the cybercrime ecosystem — watch offenders act on their motivations, see economic damage ripple, and find the policy lever that reduces harm. Defensive/educational.",
  "keywords": [
    "threat-intelligence",
    "adversary-emulation",
    "simulation",
    "agent-based-model",
    "mitre-attack",
    "blue-team",
    "security-education",
    "criminology",
    "policy-simulation",
    "cybercrime",
    "deterrence"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "globe.gl": "^2.46.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
