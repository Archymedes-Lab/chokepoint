{
  "name": "chokepoint",
  "version": "0.2.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "A dynamic, agent-based simulator of the cybercrime ecosystem \u2014 watch offenders act on their motivations, see economic damage ripple, and find the policy lever that reduces harm. Defensive/educational.",
  "keywords": [
    "threat-intelligence",
    "adversary-emulation",
    "simulation",
    "agent-based-model",
    "mitre-attack",
    "blue-team",
    "security-education",
    "criminology",
    "policy-simulation",
    "cybercrime",
    "deterrence"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
